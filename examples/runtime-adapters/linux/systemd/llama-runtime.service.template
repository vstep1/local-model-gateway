[Unit]
Description=Local Model Gateway llama-server runtime %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=localmodel
WorkingDirectory=/opt/local-model-gateway
EnvironmentFile=/etc/local-model-gateway/runtimes/%i.env
ExecStart=/usr/bin/env bash -lc 'exec "${RUNTIME_LLAMA_SERVER:-llama-server}" ${RUNTIME_MODEL_ARGS} --alias "${RUNTIME_UPSTREAM_ALIAS:-%i}" --host "${RUNTIME_HOST:-127.0.0.1}" --port "${RUNTIME_PORT}" --ctx-size "${RUNTIME_CTX_SIZE:-4096}" --gpu-layers "${RUNTIME_GPU_LAYERS:-999}" --cache-type-k "${RUNTIME_CACHE_TYPE_K:-q4_0}" --cache-type-v "${RUNTIME_CACHE_TYPE_V:-q4_0}" --parallel "${RUNTIME_PARALLEL:-1}" --jinja --no-warmup ${RUNTIME_EXTRA_ARGS:-}'
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
