[Unit]
Description=Local Model Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=localmodel
WorkingDirectory=/opt/local-model-gateway
Environment=NODE_ENV=production
EnvironmentFile=-/etc/local-model-gateway/gateway.env
ExecStart=/usr/bin/env node /opt/local-model-gateway/packages/cli/dist/src/index.js start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/local-model-gateway/data /opt/local-model-gateway/models

[Install]
WantedBy=multi-user.target
