[Unit]
Description=Local AI Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=local-ai
WorkingDirectory=/opt/local-ai-gateway
Environment=NODE_ENV=production
EnvironmentFile=-/etc/local-ai-gateway/gateway.env
ExecStart=/usr/bin/env node /opt/local-ai-gateway/packages/cli/dist/src/index.js start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/local-ai-gateway/data /opt/local-ai-gateway/models

[Install]
WantedBy=multi-user.target
