# Copy to ./runtime-adapters/minimax-m2.7-service.env and edit for your machine.
RUNTIME_ALIAS=minimax-m2.7
RUNTIME_LABEL=ai.local.runtime.minimax-m2.7
RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=8000
RUNTIME_UPSTREAM_ALIAS=MiniMaxAI/MiniMax-M2.7,minimax-m2.7,minimax/minimax-m2.7
RUNTIME_HF_REPO=unsloth/MiniMax-M2.7-GGUF
RUNTIME_HF_FILE=UD-IQ4_XS/MiniMax-M2.7-UD-IQ4_XS-00001-of-00004.gguf
RUNTIME_CTX_SIZE=98304
RUNTIME_GPU_LAYERS=56
RUNTIME_CACHE_TYPE_K=q4_0
RUNTIME_CACHE_TYPE_V=q4_0
RUNTIME_PARALLEL=1
RUNTIME_EXTRA_ARGS="--reasoning on --reasoning-format deepseek --reasoning-budget -1 --cache-ram 0 --batch-size 256 --ubatch-size 64 --no-mmap"
