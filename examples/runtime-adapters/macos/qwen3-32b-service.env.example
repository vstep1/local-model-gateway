# Copy to ./runtime-adapters/qwen3-32b-service.env and edit for your machine.
RUNTIME_ALIAS=qwen3-32b
RUNTIME_LABEL=ai.local.runtime.qwen3-32b
RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=18001
RUNTIME_PROGRESS_FILE=./runtime-adapters/qwen3-32b-load-progress.json
RUNTIME_UPSTREAM_ALIAS=qwen3-32b
RUNTIME_HF_REPO=Qwen/Qwen3-32B-GGUF
RUNTIME_HF_FILE=Qwen3-32B-Q4_K_M.gguf
RUNTIME_CTX_SIZE=131072
RUNTIME_GPU_LAYERS=999
RUNTIME_CACHE_TYPE_K=q4_0
RUNTIME_CACHE_TYPE_V=q4_0
RUNTIME_PARALLEL=1
RUNTIME_EXTRA_ARGS="--override-kv qwen3.context_length=int:131072 --rope-scaling yarn --rope-scale 4 --yarn-orig-ctx 32768"
